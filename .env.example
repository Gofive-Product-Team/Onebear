# ==============================================
# One Bear Platform - Environment Variables
# ==============================================
# Copy this file to .env and fill in the values

# --- Frontend (Vite) ---
VITE_API_BASE_URL=/api/v1
VITE_SIGNALR_URL=/hubs/chat
VITE_ENVIRONMENT=development

# --- Backend (.NET API) ---
ASPNETCORE_ENVIRONMENT=Development

# Auth (GoFive IdP)
AUTH__AUTHORITY=https://login.gofive.co.th
AUTH__AUDIENCE=onebear-api

# CORS
CORS__ORIGINS__0=http://localhost:5173

# Azure Cosmos DB
CONNECTIONSTRINGS__COSMOSDB=AccountEndpoint=https://localhost:8081;AccountKey=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==

# Redis
CONNECTIONSTRINGS__REDIS=localhost:6379

# RabbitMQ
CONNECTIONSTRINGS__RABBITMQ=amqp://guest:guest@localhost:5672

# Azure SignalR Service (leave empty for local SignalR)
AZURE__SIGNALR__CONNECTIONSTRING=

# Azure Blob Storage (UseDevelopmentStorage=true for Azurite)
AZURE__BLOBSTORAGE__CONNECTIONSTRING=UseDevelopmentStorage=true

# Azure Key Vault (optional for local dev)
AZURE__KEYVAULT__URI=

# API Keys (for internal webhooks)
APIKEYS__WEBHOOK=dev-webhook-key-change-in-production
APIKEYS__AISERVICE=dev-ai-key-change-in-production
